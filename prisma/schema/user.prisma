model User {
    id           String      @id @default(uuid())
    name         String      @db.VarChar(100)
    email        String      @unique
    password     String
    phone        String?     @db.VarChar(20)
    role         UserRole
    status       UserStatus  @default(ACTIVE)
    profileImage String?
    address      String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}