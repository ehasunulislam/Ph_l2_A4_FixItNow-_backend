model Review {
  id String @id @default(uuid())

  customerId          String
  technicianProfileId String
  bookingId           String @unique

  rating  Int
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer User @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Cascade)

  technicianProfile TechnicianProfile @relation("TechnicianReviews", fields: [technicianProfileId], references: [id], onDelete: Cascade)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("reviews")
}
